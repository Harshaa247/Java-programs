package javabasics;

public class numandsodprime {
	public static int sod(int a) {
		int s=0;
		while(a>0) {
			s=s+(a%10);
			a=a/10;
		
		}	return s;
		
	}public static boolean prime(int b) {
		if(b==1) {
			return false;
		}for(int a=2;a<b;a++) {
			if(b%a==0) {
				return false;
			}
		}return true;
	}

	public static void main(String[] args) {
		int s;
		for(int i=100;i<1000;i++) {
			s=sod(i);
			if(prime(i)&& prime(s)) {
				System.out.println(i+" ");
			}
			
		}
		
	}

}
