class Solution {
    public boolean strongPasswordCheckerII(String password) {
        if(password.length()<8){
            return false;
        }boolean up=false;
        boolean lw=false;
        boolean dg=false;
        boolean sp=false;
        String d="!@#$%^&*()-+";
        for(int i=0;i<password.length();i++){
            if(Character.isUpperCase(password.charAt(i))){
                up=true;
            }else if(Character.isLowerCase(password.charAt(i))){
                lw=true;
            }else if(Character.isDigit(password.charAt(i))){
                dg=true;
            }else if(d.indexOf(password.charAt(i))!=-1){
                sp=true;
            }else if(i>0&&password.charAt(i)==password.charAt(i-1)){
                return false;
            }}if(lw==true&&up==true&&sp==true&&dg==true){
                return true;
            }else{
                return false;
            
        }
    
    }}
